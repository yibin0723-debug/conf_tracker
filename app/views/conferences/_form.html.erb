<% if conference.errors.any? %>
  <div class="mb-4 rounded-xl border border-rosepastel-300 bg-rosepastel-100 p-4 text-rosepastel-500">
    <p class="font-semibold">
      <%= pluralize(conference.errors.count, "error") %>
      prevented this conference from being saved:
    </p>

    <ul class="mt-2 list-disc pl-5">
      <% conference.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: conference, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, class: "text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :location, class: "text-sm font-medium text-slate-700" %>
    <%= form.text_field :location, required: true, class: "input" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :starts_on, "Start date",
            class: "text-sm font-medium text-slate-700" %>
      <%= form.date_field :starts_on, required: true, class: "input" %>
    </div>

    <div>
      <%= form.label :ends_on, "End date",
            class: "text-sm font-medium text-slate-700" %>
      <%= form.date_field :ends_on, required: true, class: "input" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :submission_deadline, "Submission deadline",
            class: "text-sm font-medium text-slate-700" %>
      <%= form.date_field :submission_deadline,
            required: true,
            class: "input" %>
    </div>

    <div>
      <%= form.label :rating, "Rating",
            class: "text-sm font-medium text-slate-700" %>
      <%= form.text_field :rating,
            placeholder: "A*, A, B, CORE A...",
            class: "input" %>
    </div>
  </div>

  <div>
    <%= label_tag "conference_topic_names",
          "Topics",
          class: "text-sm font-medium text-slate-700" %>

    <%= text_field_tag "conference[topic_names]",
          params.dig(:conference, :topic_names).presence ||
            conference.topic_names,
          id: "conference_topic_names",
          placeholder: "Machine Learning, Computer Vision, NLP",
          class: "input" %>

    <p class="mt-1 text-xs text-slate-500">
      Separate multiple topics with commas.
    </p>
  </div>

  <div>
    <%= form.label :website_url, "Website URL",
          class: "text-sm font-medium text-slate-700" %>
    <%= form.url_field :website_url,
          placeholder: "https://example.org",
          class: "input" %>
  </div>

  <div>
    <%= form.label :description,
          class: "text-sm font-medium text-slate-700" %>
    <%= form.text_area :description, rows: 6, class: "input" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
